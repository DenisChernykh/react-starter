# Host-owned Caddy example. Set these environment variables in the host
# runtime; do not copy them into the frontend image or repository secrets.
{$FRONTEND_DOMAIN} {
    @backend path /v1 /v1/* /health /health/*

    handle @backend {
        reverse_proxy {$BACKEND_UPSTREAM}
    }

    handle {
        reverse_proxy {$FRONTEND_EDGE_ALIAS}:8080
    }
}
